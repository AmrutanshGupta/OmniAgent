# Required: Server port
PORT=8080

# Required: MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017

# Required: MongoDB database name
MONGODB_DB=omniagent

# Required: NextAuth JWT secret (must match frontend NEXTAUTH_SECRET)
NEXTAUTH_SECRET=your-nextauth-secret-here

# Required: AES-256 encryption key — MUST BE EXACTLY 32 CHARACTERS
ENCRYPTION_KEY=change-this-to-a-32-char-secret!

# Required: URL of the Python FastAPI backend
PYTHON_ROUTER_URL=http://localhost:8000

# Optional: Piston sandbox URL (default: http://localhost:2000)
PISTON_API_URL=http://localhost:2000

# Optional: Piston execution timeout in milliseconds (default: 5000)
PISTON_TIMEOUT_MS=5000

# Optional: Max concurrent Piston executions (default: 10)
PISTON_MAX_CONCURRENT=10

# Optional: Coder LLM max retry attempts (default: 3)
CODER_MAX_ATTEMPTS=3

# Optional: EMA alpha for observed latency smoothing (default: 0.1)
EMA_ALPHA=0.1

# Optional: Background registry ingestion interval (e.g. 6h, 1h)
CRON_SCHEDULE=6h

# Optional: Workspace root for DooD (Docker-out-of-Docker) code execution
WORKSPACE_ROOT=/tmp/omniagent/workspaces
